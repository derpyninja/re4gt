   },
   "source": [
    "#### Prepare EU-LFS data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {
    "pycharm": {
     "name": "#%%\n"
    }
   },
   "outputs": [],
   "source": [
    "from src.data.lfs import EuLfs\n",
    "from src.data.framework import Classifications\n",
    "\n",
    "# EU-LFS data\n",
    "config = utils.load_config(os.path.join(useful_paths.config_dir, \"eu_lfs_config.yml\"))\n",
    "lfs = EuLfs(config=config)\n",
    "year = 2019\n",
    "\n",
    "lfs_data = lfs.read_preprocessed_file(\n",
    "    year=year,\n",
    "    input_fname_lfs=\"eu_lfs_merged_{year}_with_final_unweighted_shares_and_earnings_incdecil_imputed\",\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {
    "pycharm": {
     "name": "#%%\n"
    }
   },
   "outputs": [],
   "source": [
    "# add column for COAL (CPO Scenario)\n",
    "# criteria for coal phase-out scenario\n",
    "coal_occupations = {\n",
    "    \"Mining, manufacturing and construction supervisors\": \"312\",\n",
    "    \"Mining and mineral processing plant operators\": \"811\",\n",
    "    \"Manufacturing, mining, construction, and distribution managers\": \"132\",\n",
    "    \"Mining and construction labourers\": \"931\",\n",
    "}\n",
    "coal_industries = {\n",
    "    \"Electricity, Gas, Steam and Air Conditioning Supply\": \"D\",\n",
    "    \"Mining and Quarrying\": \"B\",\n",
    "}\n",
    "\n",
    "occ_subset = lfs_data[\"ISCO3D_label\"].isin(list(coal_occupations.keys()))\n",
    "ind_subset = lfs_data[\"NACE1D_label\"].isin(list(coal_industries.keys()))\n",
    "\n",
    "# use totals for COAL\n",
    "lfs_data[\"COEFF_share_coal\"] = lfs_data[\"COEFF\"]\n",
    "\n",
    "# mask based on criteria\n",
    "lfs_data.loc[~(occ_subset & ind_subset), \"COEFF_share_coal\"] = np.nan"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
