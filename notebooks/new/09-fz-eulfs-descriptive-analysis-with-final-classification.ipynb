    "def se_sum(x):\n",
    "    \"\"\"\n",
    "    Calculate standard error (SE) of sum based on:\n",
    "    https://stats.stackexchange.com/questions/164505/standard-error-for-sum.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    x : np.array\n",
    "        Input array.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    (sum-se, sum+se)\n",
    "    \"\"\"\n",
    "    n = len(x)\n",
    "    sum = np.sum(x)\n",
    "    sigma = np.std(x)\n",
    "    se = np.sqrt(n) * sigma\n",
    "    return sum-se, sum+se"
   ],
